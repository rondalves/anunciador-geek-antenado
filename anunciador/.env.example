# ---- acesso ao painel ----
PORT=8080
BASE_URL=https://anuncios.seudominio.com.br
APP_PASSWORD=troque-esta-senha

# ---- Shopify (Admin > Settings > Apps > Develop apps > custom app) ----
# Escopos: write_products, read_products, write_inventory, read_inventory, read_locations, write_publications
SHOPIFY_SHOP=geekantenado.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01
SHOPIFY_PUBLICATION_ID=gid://shopify/Publication/171235442871
# SHOPIFY_LOCATION_ID=gid://shopify/Location/00000000   (opcional, senão usa a primeira ativa)

# ---- Google Drive (API key com Drive API ativada; pasta compartilhada "qualquer pessoa com o link") ----
GOOGLE_API_KEY=AIza...
DRIVE_DEFAULT_FOLDER=12dKFAYi5eIkO7VQTLA-8eUmbf6XtB1lT

# ---- Mercado Livre (developers.mercadolivre.com.br > sua aplicação) ----
# Em Redirect URI cadastre exatamente: https://anuncios.seudominio.com.br/auth/ml/callback
ML_CLIENT_ID=0000000000000000
ML_CLIENT_SECRET=xxxxxxxxxxxxxxxx
ML_SITE=MLB

# ---- opcional: escrever a descrição e preencher atributos do ML sozinho ----
# Gemini é grátis: pega a chave em aistudio.google.com/apikey (sem cartão)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# alternativa paga, só usada se GEMINI_API_KEY estiver vazia
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
